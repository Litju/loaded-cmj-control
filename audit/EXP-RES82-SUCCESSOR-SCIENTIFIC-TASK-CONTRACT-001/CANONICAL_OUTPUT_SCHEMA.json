          "type": [
            "number",
            "null"
          ],
          "description": "root pitch rate at E9 confirmation [rad/s]"
        },
        "ROOT_PITCH_RATE_AT_E10": {
          "type": [
            "number",
            "null"
          ],
          "description": "root pitch rate at E10 confirmation [rad/s]"
        },
        "ROOT_PITCH_RATE_AT_E11": {
          "type": [
            "number",
            "null"
          ],
