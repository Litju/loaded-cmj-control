        },
        "COM_VZ_AT_E11": {
          "type": [
            "number",
            "null"
          ],
          "description": "COM vz at E11 confirmation [m/s]"
        },
        "COM_SPEED_SAGITTAL_AT_E11": {
          "type": [
            "number",
            "null"
          ],
          "description": "sqrt(vx^2+vz^2) at E11 confirmation [m/s]"
        },
        "HY_AT_E11": {
          "type": [
            "number",
            "null"
          ],
          "description": "Hy at E11 confirmation [kg*m^2/s]"
        },
        "ROOT_PITCH_AT_E9": {
          "type": [
            "number",
            "null"
          ],
